# Copy values into your environment. PatchPilot does not load dotenv files.
PATCHPILOT_MODEL=your-model-id
PATCHPILOT_BASE_URL=https://api.openai.com/v1
PATCHPILOT_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
PATCHPILOT_LLM_TIMEOUT=60
PATCHPILOT_MAX_TOKENS=8192
PATCHPILOT_TOKEN_PARAMETER=max_completion_tokens
PATCHPILOT_JSON_MODE=1
